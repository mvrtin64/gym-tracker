generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Modelo descrito en docs/modelo-datos.md. Los valores de los enums son los de @gym/domain.

enum Muscle {
  front_delt
  side_delt
  rear_delt
  chest
  upper_back
  lats
  biceps
  triceps
  abs
  quads
  hamstrings
  glutes
  calves
}

enum ExerciseType {
  compound
  isolation
}

enum Level {
  beginner
  intermediate
  advanced
}

enum Focus {
  general
  lower
  upper
  specific
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// Sensación de la serie del principiante (se traduce a RIR en @gym/domain).
enum Feel {
  failure
  one_two_left
  several_left
  very_easy
}

enum RoutineOrigin {
  manual
  generated
}

/// suggest: la app solo sugiere. auto: la app aplica los ajustes sola.
enum AdjustMode {
  suggest
  auto
}

enum VolumeChangeStatus {
  suggested
  applied
  dismissed
}

/// suggested: la app propone la descarga. started: arrancó (la fase sale de startedAt). dismissed: descartada.
enum DeloadStatus {
  suggested
  started
  dismissed
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  /// Hash scrypt (ver src/auth/password.ts). Opcional para sumar después login con Google, etc.
  passwordHash  String?
  name          String
  createdAt     DateTime         @default(now())
  profile       TrainingProfile?
  volumes       MuscleVolume[]
  volumeChanges VolumeChange[]
  deloads       Deload[]
  ownExercises  Exercise[]
  exercises     UserExercise[]
  routines      Routine[]
  sessions      WorkoutSession[]
}

/// Lo que se pregunta en el onboarding (docs/dominio.md §2).
model TrainingProfile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level           Level
  trainingDays    Weekday[]
  focus           Focus     @default(general)
  priorityMuscles Muscle[]
  preferredRepMin Int?
  preferredRepMax Int?
  updatedAt       DateTime  @updatedAt
}

/// Objetivo actual de series semanales por músculo.
model MuscleVolume {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle     Muscle
  weeklySets Int
  updatedAt  DateTime @updatedAt

  @@id([userId, muscle])
}

/// Historial de cambios de volumen: explica por qué cambió y guarda las sugerencias pendientes.
model VolumeChange {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle    Muscle
  delta     Int
  reason    String
  status    VolumeChangeStatus
  createdAt DateTime           @default(now())
  /// Cuándo se aplicó o descartó. Desde ahí se vuelve a evaluar el músculo.
  decidedAt DateTime?

  @@index([userId, createdAt])
}

/// Descarga general (docs/dominio.md §5.3). El volumen de la semana y de la vuelta se calcula desde
/// startedAt sin tocar MuscleVolume, que sigue guardando el volumen al que se vuelve.
model Deload {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    DeloadStatus
  reason    String
  createdAt DateTime     @default(now())
  /// Cuándo se resolvió (arrancó o se descartó).
  decidedAt DateTime?
  startedAt DateTime?

  @@index([userId, createdAt])
}

/// Catálogo global de ejercicios. Con ownerId es un ejercicio propio, visible solo para su dueño.
model Exercise {
  id            String            @id @default(uuid())
  name          String
  type          ExerciseType
  /// Músculos a los que puede contar según el enfoque (ej. búlgara: glúteo o cuádriceps).
  targetMuscles Muscle[]
  defaultTarget Muscle
  /// GIF o link de YouTube.
  demoUrl       String?
  coachTip      String?
  ownerId       String?
  owner         User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  userData      UserExercise[]
  routines      RoutineExercise[]
  entries       ExerciseEntry[]

  @@unique([ownerId, name])
}

/// Lo del usuario sobre un ejercicio: anotación (ej. "banco a 30°") y reglas de progresión.
model UserExercise {
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId           String
  exercise             Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  note                 String?
  weightIncrementKg    Float
  startingWeightKg     Float
  deloadFactor         Float    @default(0.9)
  failuresBeforeDeload Int      @default(2)

  @@id([userId, exerciseId])
}

/// Plantilla de una sesión. Propia o generada, es el mismo objeto (docs/dominio.md §3.1).
model Routine {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  origin     RoutineOrigin     @default(manual)
  adjustMode AdjustMode        @default(suggest)
  weekday    Weekday?
  createdAt  DateTime          @default(now())
  exercises  RoutineExercise[]
  sessions   WorkoutSession[]

  @@unique([userId, name])
}

/// La prescripción vive acá: el mismo ejercicio puede ir con otro enfoque o rango en otra rutina.
model RoutineExercise {
  routineId    String
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position     Int
  targetMuscle Muscle
  sets         Int
  repMin       Int
  repMax       Int

  @@id([routineId, exerciseId])
}

model WorkoutSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Rutina de la que salió la sesión, si salió de una (para comparar con la última vez).
  routineId   String?
  routine     Routine?        @relation(fields: [routineId], references: [id], onDelete: SetNull)
  performedAt DateTime        @default(now())
  isDeload    Boolean         @default(false)
  notes       String?
  entries     ExerciseEntry[]

  @@index([userId, performedAt])
  @@index([routineId, performedAt])
}

/// Un ejercicio dentro de una sesión. targetMuscle se copia al anotar: el historial no cambia si cambia la rutina.
model ExerciseEntry {
  id           String         @id @default(uuid())
  sessionId    String
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position     Int
  targetMuscle Muscle
  sets         SetEntry[]

  @@index([exerciseId])
}

/// Se guarda lo que respondió el usuario (feel o rpe) y el RIR calculado.
model SetEntry {
  id       String        @id @default(uuid())
  entryId  String
  entry    ExerciseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position Int
  weightKg Float
  reps     Int
  warmup   Boolean       @default(false)
  feel     Feel?
  rpe      Float?
  rir      Float?
}
